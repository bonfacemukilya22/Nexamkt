{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "nx/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(index.html|app.html|signup.html|admin/.*|assets/.*)",
      "dest": "nx/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
